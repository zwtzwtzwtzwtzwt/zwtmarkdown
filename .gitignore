# --- 忽略 Obsidian 界面状态（解决多端冲突核心） ---
# 使用通配符同时覆盖 .obsidian 和 .obsidianm
.obsidian*/workspace.json
.obsidian*/workspace-mobile.json
.obsidian*/graph.json

# --- 忽略本地缓存与运行数据 ---
.obsidian*/cache/
.obsidian*/indexed-db/
.obsidian*/plugins/obsidian-git/

# --- 忽略系统垃圾桶 ---
.trash/

# --- 忽略操作系统生成的临时文件 ---
.DS_Store
Thumbs.db

